# Supabase Configuration
# Replace these with your Supabase project URL and keys from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key

# Security & Secret for Cron Endpoint (/api/cron/check-alerts)
CRON_SECRET=super_secret_cron_key_for_ticket_checker_2026

# Ticket Detection Mode: "composite" | "real" | "mock"
# In development/offline/testing mode, "mock" allows simulating ticket release transitions without live BookMyShow/District dependencies.
DEFAULT_TICKET_PROVIDER=mock

# Notification Configuration
# Options: "in_app" | "telegram" | "webhook" | "phone_call" | "multi"
DEFAULT_NOTIFICATION_CHANNEL=in_app

# Free Telegram Notification (Optional)
# Create a bot with @BotFather and get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook / n8n Automation (Optional)
# URL to trigger n8n workflow or custom webhook receiver
WEBHOOK_URL=http://localhost:5678/webhook/ticket-alert

# Future Phone Call Integration (Optional - Twilio/Exotel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
